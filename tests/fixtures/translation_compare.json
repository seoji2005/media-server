    {
      "id": "auth_00",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "en",
      "text": "Great. Just what we needed.",
      "before": "The reactor is broken again.",
      "after": "Now we will miss the launch.",
      "judge_note": "Sarcasm, not sincere praise."
    },
    {
      "id": "auth_01",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "en",
      "text": "You are not giving up on me now, are you?",
      "before": "Should I quit?",
      "after": "No, I will stay.",
      "judge_note": "Rhetorical question and negation; do not reverse the intent."
    },
    {
      "id": "auth_02",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "en",
      "text": "I let it slip.",
      "before": "You told her the ending?",
      "after": "Now the surprise is ruined.",
      "judge_note": "Accidentally disclosed information, not physically slipping."
    },
    {
      "id": "auth_03",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "en",
      "text": "Mina said she would cover for Jae.",
      "before": "Who is taking the night shift?",
      "after": "He has a medical appointment.",
      "judge_note": "Names and pronoun reference; covering a shift."
    },
    {
      "id": "auth_04",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "ja",
      "text": "いえ、結構です。",
      "before": "コーヒーのおかわりはいかがですか。",
      "after": "では、お下げします。",
      "judge_note": "Polite refusal, not acceptance."
    },
    {
      "id": "auth_05",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "ja",
      "text": "一人で大丈夫。",
      "before": "もう一度、手伝おうか。",
      "after": "わかった。何かあったら呼んで。",
      "judge_note": "Does not need help; do not turn into a request."
    },
    {
      "id": "auth_06",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "ja",
      "text": "恐れ入りますが、明日までお待ちいただけますか。",
      "before": "部長、この報告書ですが。",
      "after": "わかりました。",
      "judge_note": "Maintain a polite workplace request."
    },
    {
      "id": "auth_07",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "ja",
      "text": "来ないとは言ってない。",
      "before": "田中さんは来ないの？",
      "after": "じゃあ、まだわからないんだね。",
      "judge_note": "Double negation; attendance remains undecided."
    },
    {
      "id": "auth_08",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "ja",
      "text": "五時十五分。あと十分で着くよ。",
      "before": "駅には何時に着く？",
      "after": "じゃあ改札で待ってる。",
      "judge_note": "Preserve both 5:15 and ten minutes."
    },
    {
      "id": "auth_09",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "ja",
      "text": "RAMは足りてる。GPUのメモリがいっぱいなんだ。",
      "before": "このパソコン、遅くない？",
      "after": "設定を下げてみよう。",
      "judge_note": "Distinguish system RAM from GPU memory."
    },
    {
      "id": "auth_10",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "ja",
      "text": "そういう問題じゃない。",
      "before": "謝れば許してくれる？",
      "after": "じゃあ、どうすればいい？",
      "judge_note": "Rejects the premise, not literal problem solving."
    },
    {
      "id": "auth_11",
      "group": "authored_ordinary",
      "category": "ordinary",
      "language": "ja",
      "text": "持とうか。",
      "before": "荷物、重いでしょ。",
      "after": "ありがとう、助かる。",
      "judge_note": "Offer to carry the luggage; omitted subject/object."
    },
    {
      "id": "auth_12",
      "group": "authored_sensitive",
      "category": "profanity",
      "language": "en",
      "text": "Get the fuck out of my house!",
